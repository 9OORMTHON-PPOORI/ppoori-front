# 이 파일을 .env로 복사해 값을 채운다.
#   cp .env.example .env
#
# 두 값 모두 서버에서 실행되는 next.config.mjs의 rewrites에서만 사용되므로
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. 붙이면 백엔드 주소가 클라이언트 번들에
# 노출되어 프록시를 경유하는 의미가 없어진다.
#
# 값을 비워두면 API 프록시만 비활성화되고 빌드와 실행은 정상 동작한다.

# 정책 조회 API 오리진 — /api/policy/* 요청이 이 주소로 프록시된다
POLICY_API_ORIGIN=

# 맞춤 정책 추천 API 오리진 — /api/recommend/* 요청이 이 주소로 프록시된다
RECOMMEND_API_ORIGIN=
